## OCR 语言（可选，默认 ch）
## ch = 中文, en = 英文
MINERU_LANGUAGE=ch

## 大文件拆分阈值（可选，默认 2 MB）
## 超过此大小的 PDF 会被拆分为多段处理
MINERU_MAX_FILE_SIZE_MB=2

## 每片段最大页数（可选，默认 400）
MINERU_PAGES_PER_SPLIT=400

## 轮询超时时间（秒，可选，默认 1800 = 30 分钟）
MINERU_TIMEOUT=1800
